PORT=5000
NODE_ENV=development

# Database Configuration
DATABASE_URL=mongodb://localhost:27017/todolist

# JWT Configuration
JWT_ACCESS_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_secret_here
